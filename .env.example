# ==========================================
# CloudClean AI - Environment Configuration Template
# Copy this file to .env before starting services
# NEVER commit real production credentials to Git
# ==========================================

# ------------------------------------------
# 1. MongoDB Database
# ------------------------------------------
MONGODB_URI=mongodb://localhost:27017/cloudclean
MONGO_INITDB_ROOT_USERNAME=cloudclean_admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_mongo_password_here

# ------------------------------------------
# 2. Spring Boot Security & JWT
# ------------------------------------------
# Minimum 256-bit (32+ chars) secret key for HMAC SHA-256 JWT signing
JWT_SECRET=replace_with_a_secure_random_256_bit_jwt_secret_key_here!
JWT_EXPIRATION_MS=86400000

# 256-bit AES GCM encryption key for cloud OAuth tokens at rest (exactly 32 characters)
ENCRYPTION_SECRET=replace_with_32_chars_aes_key!

# ------------------------------------------
# 3. Google Drive OAuth 2.0 Credentials
# ------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# ------------------------------------------
# 4. Python AI Image Analysis Service
# ------------------------------------------
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_SECRET=replace_with_internal_microservice_shared_key_32chars!

# ------------------------------------------
# 5. React Frontend Configuration
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_ENV=development

# ------------------------------------------
# 6. CORS & Host Networking
# ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
PORT=8000
